#N canvas 40 40 1500 700 draw-home 0;
#X text 20 20 THE HOME SCREEN IS THE TWO LEVEL METERS. An 8px readout above each bar so the meters stay calibratable \, the bars and their gate marks from pd meters-big \, and the footer underneath., f 58;
#X obj 20 130 inlet;
#X obj 20 170 t b b b b;
#X msg 20 240 0 0 8;
#X obj 20 290 list append;
