#X text 20 20 HOME GEOMETRY -- two full-width bars 12 px tall at y 10 and y 37 \, plus the gate marks., f 58;
#X obj 20 130 r \$0-meters-big;
#X obj 200 130 r \$0-w-l;
#X obj 400 130 r \$0-w-r;
