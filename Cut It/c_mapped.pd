#X text 1600 1330 live -- 1 or 0. Right: the action gate. Left: stored for the row choice, f 40;
#X text 1100 1450 the TARGET \, scaled \, waiting for the held row, f 40;
#X text 800 1520 the VALUE \, scaled \, three copies: action \, live row \, held row, f 40;
#X text 400 1400 the row name \, once \, to both rows' cold inlets, f 40;
#X text 240 1540 arg then scaled value \, LIVE ONLY, f 40;
#X text 200 1620 1 is live: name value. 0 is held: name target (value), f 40;
