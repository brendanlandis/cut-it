#X msg 2200 480 init;
#X obj 2100 1300 spigot 1;
#X msg 1600 1250 0;
#X msg 2100 1350 fail c_steps no-lua;
#X obj 2100 1400 s err;
#X obj 1000 1700 r \$0-404;
