#X obj 1100 1826 s \$0-say;
#X msg 2300 1796 modal recording;
#X obj 2300 1826 s disp;
#X msg 2620 1796 warn u_root hidden-warn;
#X obj 2620 1826 s err;
#X obj 140 1880 del 10000;
