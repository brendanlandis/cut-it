#N canvas 20 20 1660 1060 12;
#X text 20 20 u_mother-stub -- impersonates mother.pd when Cut It runs on the Mac \, where mother.pd does not exist. main-dev.pd instantiates it \; main.pd does not \, so the device never sees it., f 58;
#X text 20 110 creation args: none. inlets: none. outlets: none., f 58;
#X text 20 150 THE ONE SANCTIONED EXCEPTION to the reserved-name rule in plan-conventions.md -- it deliberately sends on names owned by mother.pd. That is its entire purpose., f 58;
#X text 20 225 KNOBS AND VOLUME -- mother divides the raw 0 to 1023 reading by 1023 \, so a patch sees 0 to 1., f 58;
#X obj 20 295 hsl 128 15 0 1 0 0 empty empty knob1 -2 -8 0 10 -262144 -1 -1 0 1;
#X floatatom 170 295 5 0 0 0 - - -;
#X obj 240 295 s knob1;
#X obj 20 335 hsl 128 15 0 1 0 0 empty empty knob2 -2 -8 0 10 -262144 -1 -1 0 1;
#X floatatom 170 335 5 0 0 0 - - -;
#X obj 240 335 s knob2;
#X obj 20 375 hsl 128 15 0 1 0 0 empty empty knob3 -2 -8 0 10 -262144 -1 -1 0 1;
#X floatatom 170 375 5 0 0 0 - - -;
#X obj 240 375 s knob3;
#X obj 20 415 hsl 128 15 0 1 0 0 empty empty knob4 -2 -8 0 10 -262144 -1 -1 0 1;
#X floatatom 170 415 5 0 0 0 - - -;
#X obj 240 415 s knob4;
#X obj 20 460 hsl 128 15 0 1 0 0 empty empty vol -2 -8 0 10 -262144 -1 -1 0 1;
#X floatatom 170 460 5 0 0 0 - - -;
#X obj 240 460 s vol;
#X text 20 500 KEYBOARD NOTES -- mother packs note and velocity into one two-float list. The lowest key is note 60., f 58;
#X obj 20 565 bng 15 250 50 0 empty empty empty 17 7 0 10 -262144 -1 -1;
#X floatatom 60 565 5 0 0 0 - - -;
#X floatatom 130 565 5 0 0 0 - - -;
#X obj 20 600 pack 60 100;
#X obj 20 630 s notes;
#X text 200 563 the bang re-sends the current pair. Set velocity to 0 for a note-off., f 34;
#X text 20 670 AUX AND ENCODER -- all momentary 1/0 \, read out of Organelle_UI/main.cpp. The encoder is NOT plus/minus 1. mother only forwards enc and encbut once the patch has asked with /enableEncoder., f 58;
#X text 20 770 aux;
#X msg 20 795 1;
#X msg 55 795 0;
#X obj 20 825 s aux;
#X text 200 770 encbut;
#X msg 200 795 1;
#X msg 235 795 0;
#X obj 200 825 s encbut;
#X text 380 770 enc -- 1 up \, 0 down;
#X msg 380 795 1;
#X msg 415 795 0;
#X obj 380 825 s enc;
#X text 560 205 SCREEN LINES -- the five text lines mother.pd gives a patch. Each chain ends in a preview box showing what the patch wrote., f 40;
#X obj 560 300 r screenLine1;
#X obj 560 328 list prepend set;
#X obj 560 356 list trim;
#X msg 560 386 .....................;
#X text 780 386 screenLine1;
#X obj 560 420 r screenLine2;
#X obj 560 448 list prepend set;
#X obj 560 476 list trim;
#X msg 560 506 .....................;
#X text 780 506 screenLine2;
#X obj 560 540 r screenLine3;
#X obj 560 568 list prepend set;
#X obj 560 596 list trim;
#X msg 560 626 .....................;
#X text 780 626 screenLine3;
#X obj 560 660 r screenLine4;
#X obj 560 688 list prepend set;
#X obj 560 716 list trim;
#X msg 560 746 .....................;
#X text 780 746 screenLine4;
#X obj 560 780 r screenLine5;
#X obj 560 808 list prepend set;
#X obj 560 836 list trim;
#X msg 560 866 .....................;
#X text 780 866 screenLine5;
#X text 1080 205 OSC OUT -- the OLED graphics API. This shows WHAT is drawn \, not WHERE. Positioned rendering is deliberately out of scope., f 40;
#X obj 1080 300 r oscOut;
#X obj 1080 330 route sendtyped;
#X obj 1260 370 print oscOut-not-sendtyped;
#X obj 1080 410 route /oled/gPrintln /oled/gClear;
#X obj 1080 460 list split 1;
#X obj 1080 490 list split 5;
#X obj 1080 520 list prepend set;
#X obj 1330 460 t b;
#X msg 1330 490 set;
#X obj 1080 600 list trim;
#X msg 1080 640 .....................;
#X text 1260 640 gPrintln text;
#X obj 1330 560 route /oled/gFlip /oled/gShowInfoBar;
#X obj 1400 640 print oscOut;
#X text 1080 690 SELF-TEST -- click these three to prove the chain above works: text appears \, then blanks \, then an unhandled command reaches the console. Nothing else in the patch may send on oscOut., f 58;
#X msg 1080 780 sendtyped /oled/gPrintln iiiiii 3 4 6 24 1 hello there;
#X msg 1080 815 sendtyped /oled/gClear ii 3 1;
#X msg 1080 850 sendtyped /oled/gFilledCircle iiiii 3 10 10 8 1;
#X obj 1080 885 s oscOut;
#X text 1080 930 gPrintln: drop the typetag \, then screen \, x \, y \, height and colour -- what is left is the text. gClear blanks the box. gFlip and gShowInfoBar are ignored on purpose: they would flood the console., f 58;
