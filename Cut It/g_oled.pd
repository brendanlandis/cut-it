#N canvas 40 40 1000 620 meters-small 0;
#X text 20 20 SHRUNK GEOMETRY -- a 5 px strip at the bottom \, shared by the param and modal layers. The meters never disappear entirely \, so signal presence is readable whatever else the screen is doing., f 58;
#X obj 20 130 r \$0-meters-small;
#X obj 200 130 r \$0-w-l;
#X obj 400 130 r \$0-w-r;
#X obj 20 170 t b b;
#X obj 20 240 f 1;
