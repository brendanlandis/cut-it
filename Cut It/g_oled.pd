#X text 180 534 what the home screen says before anything has happened, f 40;
#X obj 20 580 loadbang;
#X obj 20 620 del 300;
#X obj 20 660 metro 100;
#X obj 20 710 t b b b b b;
#X msg 400 760 sendtyped /oled/gShowInfoBar ii 3 0;
#X msg 700 760 sendtyped /oled/gClear ii 3 1;
#X msg 980 760 sendtyped /oled/gFlip i 3;
#X obj 1250 760 r \$0-raw;
#X obj 700 830 s oscOut;
#N canvas 40 40 1300 700 pick 0;
#X text 20 20 PRIORITY AS A CASCADE \, NOT ARITHMETIC. select 1 passes the non-matching 0 out of its right outlet \, so this reads top to bottom in exactly priority order. Adding a layer is one more link., f 58;
#X obj 20 130 inlet;
#X obj 20 190 f;
#X obj 140 150 r \$0-a-alert;
#X obj 20 240 select 1;
#X obj 20 300 outlet;
#X obj 340 190 f;
#X obj 460 150 r \$0-a-modal;
#X obj 340 240 select 1;
#X obj 340 300 outlet;
#X obj 660 190 f;
#X obj 780 150 r \$0-a-param;
#X obj 660 240 select 1;
#X obj 660 300 outlet;
#X obj 240 300 t b;
#X obj 560 300 t b;
#X obj 880 300 t b;
#X obj 980 380 outlet;
#X text 20 460 Outlet order is x position \, so left to right these are alert \, modal \, param \, home -- highest priority first \, which is also the order they are tested in., f 46;
#X text 420 460 f with no argument starts at 0 \, so before anything has ever fired \, every layer is down and home draws. That is the correct cold-start behaviour and it costs nothing., f 46;
#X text 820 460 The t b is not decoration: select's right outlet emits the float it did not match \, and f wants a bang on its hot inlet \, not a 0 -- a 0 would overwrite the flag it is about to read., f 46;
#X connect 3 0 2 1;
#X connect 2 0 4 0;
#X connect 4 0 5 0;
#X connect 7 0 6 1;
#X connect 6 0 8 0;
#X connect 8 0 9 0;
#X connect 11 0 10 1;
#X connect 10 0 12 0;
#X connect 12 0 13 0;
#X connect 1 0 2 0;
#X connect 4 1 14 0;
#X connect 14 0 6 0;
#X connect 8 1 15 0;
#X connect 15 0 10 0;
#X connect 12 1 16 0;
#X connect 16 0 17 0;
#X restore 20 780 pd pick;
#N canvas 40 40 1400 700 draw-alert 0;
#X text 20 20 An alert preempts everything. Border \, then the level at 16px \, then the source and the text at 8px -- 21 characters \, and gPrintln does not wrap., f 58;
#X obj 20 130 inlet;
#X obj 20 170 t b b b b;
#X msg 900 240 sendtyped /oled/gBox iiiiii 3 0 0 127 63 1;
#X obj 900 300 s \$0-raw;
#X msg 20 240 6 6 16;
#X obj 20 290 list append;
#X obj 180 250 r \$0-a-level;
#X obj 20 340 s \$0-text;
