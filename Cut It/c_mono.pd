#N canvas 20 20 1900 1500 12;
#X text 20 20 c_mono -- a basic Pd voice \, one note at a time: sine \, saw or square \, through a filter that opens with the envelope. Inlet: note <n> <v> \, 0 a release \, which only the note sounding answers \; wave <0 sine \, 1 saw \, 2 square> chooses \, wave -1 off. Its outlet~ goes up to u_root \, into the Fx channel \, the right output \, mixer channel 2 (Brendan \, 2026-11-05). To save CPU only the chosen wave runs \, and the whole voice only while a note sounds and rings out: switch~ ends it 220 ms after a release., f 70;
#X obj 20 160 inlet;
#X obj 20 200 route note wave tone;
#X obj 20 250 unpack f f;
#X obj 120 300 f;
#X obj 20 300 t b f;
#X obj 20 350 f;
#X obj 260 350 f;
#X obj 120 350 moses 1;
#X obj 20 400 t f b b;
#X obj 80 450 t f f;
#X obj 360 450 f;
#X obj 80 500 mtof;
#X obj 80 540 pack f 4;
#X obj 80 580 line~ 440;
#X obj 20 650 / 127;
#X obj 20 700 t f f;
#X obj 100 740 * 0.6;
#X obj 20 780 pack f f 6;
#X msg 20 830 \$1 \$3 \, \$2 200 \$3;
#X obj 20 1100 vline~;
#X obj 260 400 t b b;
#X obj 260 500 ==;
#X obj 260 550 sel 1;
#X obj 260 600 t b b;
#X msg 260 650 0 \$1;
#X obj 360 650 del 220;
#X msg 360 700 0;
#X msg 460 450 stop;
#X obj 460 400 f 0;
#X obj 460 500 sel 1;
#X msg 540 550 1;
#X obj 600 250 moses 0;
#X obj 600 300 t b b;
#X msg 600 350 0;
#X obj 700 300 t b f;
#X msg 700 350 1;
#X obj 560 620 switch~;
#X obj 760 350 == 0;
#X obj 850 350 == 1;
#X obj 940 350 == 2;
#N canvas 0 0 320 220 sine 0;
#X obj 20 20 inlet~;
#X obj 20 70 osc~;
#X obj 20 120 outlet~;
#X obj 160 20 inlet;
#X obj 160 70 switch~;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X restore 400 800 pd sine;
#N canvas 0 0 320 220 saw 0;
#X obj 20 20 inlet~;
#X obj 20 70 else/bl.saw~;
#X obj 20 120 outlet~;
#X obj 160 20 inlet;
#X obj 160 70 switch~;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X restore 520 800 pd saw;
#N canvas 0 0 320 220 square 0;
#X obj 20 20 inlet~;
#X obj 20 70 else/bl.square~;
#X obj 20 120 outlet~;
#X obj 160 20 inlet;
#X obj 160 70 switch~;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X restore 660 800 pd square;
#X msg 1040 350 -1;
#X obj 200 1150 *~ 5;
#X obj 200 1190 +~ 1.5;
#X obj 200 1230 *~;
#X obj 400 1280 vcf~ 1.5;
#X obj 400 1330 *~;
#X obj 400 1370 *~ 0.7;
#X obj 400 1410 outlet~;
#X obj 1200 160 route attack release bright level;
#X obj 1200 220 expr 1 + \$f1 * \$f1 * 800;
#X obj 1400 220 expr 20 + \$f1 * \$f1 * 3000;
#X obj 1400 270 t f f;
#X obj 1500 320 + 70;
#X obj 1600 220 expr \$f1 * \$f1 * 20;
#X obj 1800 220 * 1;
#X obj 260 625 f 150;
#X text 1200 400 tone <param> <0-1> \, from a patch: attack 1 to 800 ms \, release 20 to 3000 ms \, how far the filter opens \, and the level. The voice shuts 70 ms after its release., f 50;
