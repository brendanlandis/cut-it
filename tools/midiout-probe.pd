#N canvas 20 20 2200 1200 12;
#X text 20 20 midiout-probe -- WHICH HALF IS BROKEN. When the 404 does not follow the clock \, the question is whether Pd is emitting at all or whether the 404 is ignoring it. Nothing here touches the Cut It patch -- it talks straight to the MIDI ports. Open it on its own or alongside main-dev.pd \, either works. SET Pd MEDIA - MIDI SETTINGS - OUTPUT DEVICE 1 = SP-404 FIRST \, then work down the buttons in order. The useful information is in WHICH ones work., f 96;
#X text 20 240 A -- RAW BYTES OUT OF midiout ON PORT 1 \, the port set into the cold inlet at load. This is EXACTLY how u_tempo sends clock. If pad 1 fires \, that mechanism works., f 44;
#X obj 20 400 bng 32 250 50 0 empty empty A-pad1-via-midiout-port1 0 -18 0 12 -262144 -1 -1;
#X obj 20 450 t b b b;
#X msg 20 500 144;
#X msg 100 500 48;
#X msg 180 500 100;
#X obj 20 570 midiout;
#X obj 300 460 loadbang;
#X msg 300 505 1;
#X text 620 240 B -- THE SAME PAD VIA noteout 1 \, which reaches port 1 by CHANNEL rather than through a port inlet. If B fires and A does not \, midiout's port inlet is the fault and u_tempo must change. If both fire \, MIDI out is fine and the 404 is the question., f 44;
#X obj 620 400 bng 32 250 50 0 empty empty B-pad1-via-noteout1 0 -18 0 12 -262144 -1 -1;
#X obj 620 450 t b b;
#X msg 620 500 48 100;
#X msg 760 500 48 0;
#X obj 620 570 noteout 1;
#X text 1240 240 C -- THE SAME BYTES ON PORT 3 \, which does not exist on this Mac \, so pad 1 must NOT fire. If it does \, the port inlet is being ignored and every byte is going everywhere., f 44;
#X obj 1240 400 bng 32 250 50 0 empty empty C-port3-must-stay-silent 0 -18 0 12 -262144 -1 -1;
#X obj 1240 450 t b b b;
#X msg 1240 500 144;
#X msg 1320 500 48;
#X msg 1400 500 100;
#X obj 1240 570 midiout;
#X obj 1520 460 loadbang;
#X msg 1520 505 3;
#X text 20 700 D -- A HAND-ROLLED CLOCK ON PORT 1: 248 every 20.833 ms \, which is 120 BPM. metro rather than phasor \, deliberately -- this shares no code with u_tempo. Send start first \, then run the clock. If the 404 follows THIS but not the patch \, the fault is in u_tempo. If it follows neither \, the 404 is not acting on clock at all., f 60;
#X obj 20 880 bng 32 250 50 0 empty empty D1-start-250 0 -18 0 12 -262144 -1 -1;
#X obj 200 880 tgl 32 0 empty empty D2-run-clock-120bpm 0 -18 0 12 -262144 -1 -1 0 1;
#X obj 460 880 bng 32 250 50 0 empty empty D3-stop-252 0 -18 0 12 -262144 -1 -1;
#X obj 200 930 metro 20.833;
#X msg 20 980 250;
#X msg 200 980 248;
#X msg 460 980 252;
#X obj 20 1040 midiout;
#X obj 700 940 loadbang;
#X msg 700 985 1;
#X text 1240 700 E -- IF YOU EVER SET UP AN IAC LOOPBACK this prints the bytes Pd actually emitted -- 248 clock \, 250 start \, 252 stop. With no loopback it stays silent \, and that means nothing either way., f 50;
#X obj 1240 880 midirealtimein;
#X obj 1240 930 print RT-IN;
