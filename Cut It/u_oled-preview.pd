#X text 740 1120 row 4 -- y 32-39 -- home R bar, f 24;
#X obj 920 1000 list prepend set;
#X obj 920 1040 list trim;
#X msg 920 1080 .....................;
#X text 920 1120 row 5 -- y 40-47 -- alert text, f 24;
#X obj 1100 1000 list prepend set;
#X obj 1100 1040 list trim;
#X msg 1100 1080 .....................;
#X text 1100 1120 row 6 -- y 48-55 -- home footer \, shrunk L bar, f 24;
#X obj 1280 1000 list prepend set;
#X obj 1280 1040 list trim;
#X msg 1280 1080 .....................;
#X text 1280 1120 row 7 -- y 56-63 -- shrunk R bar, f 24;
#X text 20 1230 BENCH -- click these and watch the boxes above. This is the whole Phase 3 acceptance run: levels \, a parameter with a unit and one without \, a modal \, and both error levels through u_err's mode filter., f 58;
#X msg 20 1310 in-l 43 dB;
#X obj 20 1350 s disp;
#X msg 360 1310 in-r 19 dB;
#X obj 360 1350 s disp;
#X msg 700 1310 chop-size 43 %;
#X obj 700 1350 s disp;
#X msg 1040 1310 grain 12;
#X obj 1040 1350 s disp;
#X msg 1380 1310 modal recording;
#X obj 1380 1350 s disp;
#X msg 20 1400 modal-off;
#X obj 20 1440 s disp;
#X msg 360 1400 warn u_root test-warn;
#X obj 360 1440 s err;
#X msg 700 1400 fail u_root test-fail;
#X obj 700 1440 s err;
#X msg 1040 1400 compose;
#X obj 1040 1440 s mode;
#X msg 1380 1400 perform;
#X obj 1380 1440 s mode;
#X text 20 1490 SELF-TEST on the raw api -- these bypass g_oled entirely and go straight at oscOut \, so they check this previewer rather than the arbiter., f 58;
