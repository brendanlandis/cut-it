#N canvas 20 20 2600 1700 12;
#X declare -lib pdlua;
#X text 20 20 c_synth -- the synth choice and the router. It holds which synth the nanoKEY plays \, fm (the Volca) or strings (the Streichfett) \, on every page \, and sends each key's release to the synth its press went to \, so a switch mid-chord leaves nothing hanging. ref/module/synths.md, f 70;
#X text 20 170 inlet: <note> <velocity> from m_nanokey \, 0 a release \, synth <choice> from u_map (a page-3 pad) and u_net (the phone) \, and velocity <on or off> from u_net. outlet 1: note <n> <v> \, to m_volca. outlet 2: note <n> <v> \, to m_streich. outlet 3: synth <choice> \, to u_net. outlet 4: the same \, to g_grid. outlet 5: velocity <on or off> \, to u_net. Each on a change \, and once at load and at the restore. The choice and the setting are the auto keys synth and velocity., f 70;
#X obj 20 400 inlet;
#X obj 20 700 c_synth-lua;
#X obj 20 1000 outlet;
#X obj 300 1000 outlet;
#X obj 600 800 t a a;
#X obj 600 1000 outlet;
#X obj 900 1000 outlet;
#X obj 1200 800 list prepend put auto;
#X obj 1200 850 list trim;
