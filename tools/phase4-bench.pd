#N canvas 20 20 4400 3120 12;
#X text 20 20 phase4-bench -- the Phase 4 acceptance run. Ten seconds a step \, so you can watch the OLED and mark each one off. Load it as a THIRD patch after mother.pd and main.pd. It touches nothing in the deployed patch: it only pushes onto disp \, err and mode., f 110;
#X text 20 110 RUN IN THE FOREGROUND. Every step prints what it is sending and a PASS IF line -- including the steps whose correct result is that NOTHING happens \, which are otherwise impossible to mark. Steps 1 to 14 drive themselves \; 15 to 17 need your hands on the nanoKONTROL., f 110;
#X text 20 200 EVERY STEP RE-ASSERTS ITS OWN PRECONDITIONS -- the lesson from phase3-bench \, where a 30 s modal TTL expired mid-run at 10 s a step and read as three failures that were really the safety net working., f 110;
#X obj 2300 260 r \$0-say;
#X obj 2300 300 print;
#X obj 20 300 loadbang;
#X obj 140 380 del 6000;
#X obj 240 408 t b b;
#X msg 320 446 === STEP-01-of-18 === baseline -- sending nothing;
#X obj 320 476 s \$0-say;
#X msg 1100 446 PASS IF: two bars with a small gate mark under each and v0.2-ready at the bottom;
#X obj 1100 476 s \$0-say;
#X obj 140 530 del 10000;
#X obj 240 558 t b b b;
#X msg 320 596 === STEP-02-of-18 === ONE MOVER -- chop-size 43 %;
#X obj 320 626 s \$0-say;
#X msg 1100 596 PASS IF: chop-size small on the top line and a BIG 43 % under it -- this is the Phase 3 layout and it must be unchanged;
#X obj 1100 626 s \$0-say;
#X msg 2300 596 chop-size 43 %;
#X obj 2300 626 s disp;
#X obj 140 680 del 10000;
#X obj 240 708 t b b b b;
#X msg 320 746 === STEP-03-of-18 === TWO MOVERS -- chop-size and grain together;
#X obj 320 776 s \$0-say;
#X msg 1100 746 PASS IF: TWO stacked pairs -- chop-size over 43 % on top and grain over 12 below -- FIRST TOUCHED on top and the value mid-sized;
#X obj 1100 776 s \$0-say;
#X msg 2300 746 chop-size 43 %;
#X obj 2300 776 s disp;
#X msg 2620 746 grain 12;
#X obj 2620 776 s disp;
#X obj 140 830 del 10000;
#X obj 240 858 t b b b b b b b;
#X msg 320 896 === STEP-04-of-18 === FIVE MOVERS;
#X obj 320 926 s \$0-say;
#X msg 1100 896 PASS IF: FIVE small lines in the order they were first touched: chop-size then grain then slider-1 then knob-3 then btn-t-2;
#X obj 1100 926 s \$0-say;
#X msg 2300 896 chop-size 43 %;
#X obj 2300 926 s disp;
#X msg 2620 896 grain 12;
#X obj 2620 926 s disp;
