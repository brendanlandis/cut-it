#N canvas 40 40 1500 800 alert-in 0;
#X text 20 20 alert <level> <source> <text> -- from u_err \, which has already decided this one is allowed on screen. All three fields are cleared first., f 58;
#X obj 20 110 inlet;
#X obj 20 150 list append;
#X obj 20 190 t b l l;
