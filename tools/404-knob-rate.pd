#N canvas 40 40 950 640 12;
#X obj 30 60 r knob2;
#X obj 30 105 expr 500 * exp(-6.2146 * $f1);
#X obj 30 150 t f f;
#X obj 30 195 metro 500;
#X obj 30 240 f;
#X obj 110 240 + 1;
#X obj 30 285 mod 2;
#X obj 30 330 select 0 1;
#X msg 30 375 50;
#X msg 150 375 51;
#X obj 30 420 makenote 127 20;
#X obj 30 465 noteout 33;
#X obj 330 105 expr int(1000/$f1);
#X obj 330 150 t f f;
#X msg 330 195 rate \$1 hz;
#X obj 330 240 s disp;
#X obj 610 60 netreceive 9995 1;
#X obj 610 105 route go stop read;
#X msg 610 150 1;
#X msg 680 150 0;
#X obj 760 195 f;
#X obj 760 240 print RATE;
#X text 30 20 404 RATE ON KNOB 2 -- sweep the trigger rate BY HAND and stop where the perceptual difference stops. That point is the measurement., f 104;
#X text 480 300 EXPONENTIAL FROM 2 TO 1000 PER SECOND \, because pitch is logarithmic and a linear knob would cram every interesting rate into the last few degrees. 500 * exp(-6.2146 * k) is the interval in ms -- k=0 gives 500 ms and k=1 gives 1 ms. exp rather than pow avoids a comma inside the object box \, which would split it., f 60;
#X text 480 430 THE TOP IS DELIBERATELY PAST THE WALL. 1000 per second is well beyond the measured useful ceiling of about 500 \, so the knob can be swept THROUGH the limit rather than up to it -- the point where turning further stops changing anything is the answer., f 60;
#X text 480 540 THE RATE IS PUBLISHED ON disp so it reads live on the OLED while the knob moves. Send read over UDP 9995 to print it to the console as well -- ⚠️ the OLED lags the audio by about 200 ms so trust the number rather than the timing., f 60;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
