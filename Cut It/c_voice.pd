#X obj 300 880 expr pow(10 \, 1.5 * (\$f1 / 127 - 1) + \$f2 / 20);
#X obj 300 920 pack f f;
#X msg 300 960 0 2 \, \$1 1 2 \, 0 3 \$2;
#X msg 400 1020 0 0 2 \, \$1 \$2 2;
#X obj 400 1060 vline~;
#X obj 300 1060 vline~;
#X obj 400 1100 tabread4~ \$0-smp;
#X obj 400 1140 *~;
#X obj 400 1180 outlet~;
#X obj 120 880 t b b;
#X msg 20 960 1;
#X obj 120 920 f;
#X obj 120 960 del;
