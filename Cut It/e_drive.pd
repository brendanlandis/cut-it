#X obj 500 20 inlet;
#X obj 20 60 *~ 32;
#X obj 20 100 +~ 0.5;
#X obj 120 140 wrap~;
#X obj 20 180 -~;
#X obj 300 180 phasor~;
#X obj 20 220 samphold~;
#X obj 20 260 *~ 0.03125;
