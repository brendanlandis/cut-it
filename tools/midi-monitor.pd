#N canvas 50 50 700 460 12;
#X obj 30 40 notein;
#X obj 30 100 pack f f f;
#X obj 30 140 print NOTE;
#X obj 330 40 ctlin;
#X obj 330 100 pack f f f;
#X obj 330 140 print CC;
#X obj 30 230 loadbang;
#X msg 30 270 midi-test-patch-loaded;
#X obj 30 310 print INFO;
#X text 30 360 NOTE prints: pitch velocity channel;
#X text 30 380 CC prints: value controller channel;
#X text 30 400 Pd channel = (device-1)*16 + midi channel;
#X connect 0 0 1 0;
#X connect 0 1 1 1;
#X connect 0 2 1 2;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X connect 3 1 4 1;
#X connect 3 2 4 2;
#X connect 4 0 5 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
