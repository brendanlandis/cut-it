#X obj 240 7200 s \$0-say;
#X obj 20 7320 select 8;
#X obj 240 7320 t b b b;
#X msg 480 7320 xport-1 1;
#X obj 480 7365 s param;
#X msg 480 7430 slider-1 100;
#X obj 480 7475 s param;
#X msg 480 7610 --- step 8 fired --- judge it against the PASS IF above --- press GO for step 9;
#X obj 240 7670 s \$0-say;
#X obj 20 7790 select 9;
#X obj 240 7790 t b;
#X msg 480 7860 --- step 9 fired --- judge it against the PASS IF above --- press GO for step 10;
#X obj 240 7920 s \$0-say;
#X obj 20 8040 select 10;
#X obj 240 8040 t b;
#X msg 480 8110 --- step 10 fired --- judge it against the PASS IF above --- press GO for step 11;
#X obj 240 8170 s \$0-say;
#X obj 20 8290 select 11;
#X obj 240 8290 t b;
#X msg 480 8360 --- step 11 fired --- that was the last one --- press GO to finish;
