#X obj 2940 926 s disp;
#X msg 3260 896 knob-3 100;
#X obj 3260 926 s disp;
#X msg 3580 896 btn-t-2 1;
#X obj 3580 926 s disp;
#X obj 140 980 del 10000;
#X obj 240 1008 t b b b b b b b b b;
