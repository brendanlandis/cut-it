#N canvas 40 40 1400 700 draw-alert 0;
#X text 20 20 An alert preempts everything. Border \, then the level at 16px \, then the source and the text at 8px -- 21 characters \, and gPrintln does not wrap., f 58;
#X obj 20 130 inlet;
#X obj 20 170 t b b b b;
#X msg 900 240 sendtyped /oled/gBox iiiiii 3 0 0 127 63 1;
