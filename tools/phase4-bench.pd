#X obj 320 1076 s \$0-say;
#X msg 1100 1046 PASS IF: still exactly FIVE lines -- a1 a2 a3 a4 a5 -- and a6 and a7 are REFUSED rather than pushing the rows around. Nothing shifts;
#X obj 1100 1076 s \$0-say;
#X msg 2300 1046 a1 1;
#X obj 2300 1076 s disp;
